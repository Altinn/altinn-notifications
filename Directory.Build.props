<Project>
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- SSH.NET <= 2025.1.0, pulled in transitively via Testcontainers 4.13.0 (test-only, no ScpClient usage).
	     Scoped to the projects that actually resolve it so other (e.g. production) projects keep audit coverage.
	     Testcontainers has not yet released a version referencing a patched SSH.NET (>= 2026.0.0). Remove once it does. -->
	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Altinn.Notifications.Shared.TestInfrastructure'
		Or '$(MSBuildProjectName)' == 'Altinn.Notifications.IntegrationTestsASB'
		Or '$(MSBuildProjectName)' == 'Altinn.Notifications.Sms.IntegrationTestsASB'
		Or '$(MSBuildProjectName)' == 'Altinn.Notifications.Email.IntegrationTestsASB'
		Or '$(MSBuildProjectName)' == 'Altinn.Notifications.Tools.Tests'">
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
	</ItemGroup>
</Project>