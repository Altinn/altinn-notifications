meta {
  name: enduser
  seq: 7
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{enduser_jwt}}
}

script:pre-request {
  // Auto-fetch a valid bearer token for an end user
  if(   
    //no token
    !bru.getEnvVar("enduser_jwt") || bru.getEnvVar("enduser_jwt") === "null" ||
    
    //new env
    bru.getEnvVar("enduser_jwt_env") !== bru.getEnvVar("Environment") ||
    
    //old token (expired)
    (bru.getEnvVar("enduser_jwt_from") + 15*60*1000) < Date.now() 
    ){
    const requestResponse = await bru.runRequest("test-util/end user dialog token");
  
    if(requestResponse.status == 200){
      console.log('Automatically (re)-aquired a JWT');
    }else{
      console.log('Failed automatically (re)-aquirering a JWT');
    }
  }
}
