meta {
  name: shipment is cancelled
  type: http
  seq: 3
}

get {
  url: {{host}}/notifications/api/v1/future/shipment/{{e2e_shipment_id}}
  body: none
  auth: inherit
}

tests {
  test("shipment is Order_Cancelled", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("Order_Cancelled");
  });
}
