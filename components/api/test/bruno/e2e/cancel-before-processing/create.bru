meta {
  name: create order a year ahead
  type: http
  seq: 1
}

post {
  url: {{host}}/notifications/api/v1/future/orders
  body: json
  auth: inherit
}

body:json {
  {
    "idempotencyId": "{{random_idempotency_id}}",
    "sendersReference": "e2e-{{senders_reference_guid}}",
    "requestedSendTime": "{{e2e_requested_send_time}}",
    "recipient": {
      "recipientEmail": {
        "emailAddress": "{{process.env.TESTDATA_MY_EMAIL}}",
        "emailSettings": {
          "subject": "(E2E) Cancel before processing",
          "body": "(E2E) Cancel before processing - {{random_idempotency_id}}",
          "contentType": "Plain",
          "sendingTimePolicy": "Anytime"
        }
      }
    }
  }
}

script:pre-request {
  const sendTime = new Date();
  sendTime.setFullYear(sendTime.getFullYear() + 1);
  bru.setVar("e2e_requested_send_time", sendTime.toISOString());
}

script:post-response {
  // Clear the shipment first, so a failed create never leaves the next request on an older one.
  bru.setVar("e2e_shipment_id", null);
  if (res.status === 201) {
    bru.setVar("e2e_shipment_id", res.body.notification.shipmentId);
  }
}

tests {
  test("returns 201 Created with a shipment", function() {
    expect(res.status).to.equal(201);
    expect(res.body.notification.shipmentId).to.be.a("string");
  });
}
