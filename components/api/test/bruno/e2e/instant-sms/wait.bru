meta {
  name: wait for SMS_Delivered
  type: http
  seq: 2
}

get {
  url: {{host}}/notifications/api/v1/future/shipment/{{e2e_shipment_id}}
  body: none
  auth: inherit
}

vars:pre-request {
  expected_status: SMS_Delivered
}

tests {
  test("recipient ends as SMS_Delivered", function() {
    expect(res.status).to.equal(200);
    const statuses = res.body.recipients.map(r => r.status);
    expect(statuses, `recipient statuses: ${statuses.join(", ")}`).to.include(bru.getRequestVar("expected_status"));
  });
}
