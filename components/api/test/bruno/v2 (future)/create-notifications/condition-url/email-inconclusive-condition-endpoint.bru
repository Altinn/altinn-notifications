meta {
  name: email - inconclusive condition endpoint (404)
  type: http
  seq: 5
}

post {
  url: {{host}}/notifications/api/v1/future/orders
  body: json
  auth: inherit
}

body:json {
  {
    "idempotencyId": "{{random_idempotency_id}}",
    "sendersReference": "{{random_idempotency_id}}",
    "conditionEndpoint": "{{host}}/notifications/api/v1/tests/sendcondition/does-not-exist",
    "recipient": {
      "recipientEmail": {
        "emailAddress": "{{process.env.TESTDATA_MY_EMAIL}}",
        "emailSettings": {
          "subject": "(TEST) Inconclusive condition email",
          "body": "(TEST) Inconclusive condition test (Env.: {{Environment}} - Ref: {{random_idempotency_id}})",
          "contentType": "Plain",
          "sendingTimePolicy": "Anytime"
        }
      }
    }
  }
}

docs {
  Email order whose condition endpoint returns 404, so the condition check is inconclusive.
  
  Expected: the email notification is set to Retrying on the first attempt, is claimed again by the retry loop after RetryNotificationsDBDelaySeconds,
  and is sent if the endpoint fails again (the condition is then treated as met).
  
  Required environment variables:
  - TESTDATA_MY_EMAIL: Your email address for testing
}
