meta {
  name: new auth token
  type: http
  seq: 1
}

get {
  url: {{token_generator_url}}/api/GetEnterpriseToken?env={{Environment}}&scopes=altinn:serviceowner/notifications.create&org=ttd
  body: none
  auth: basic
}

params:query {
  env: {{Environment}}
  scopes: altinn:serviceowner/notifications.create
  org: ttd
}

auth:basic {
  username: {{token_generator_user}}
  password: {{token_generator_password}}
}

script:pre-request {
  // An environment can point to its own token generator, e.g. the mock issuer in "v2 aspire".
  // Otherwise the Altinn test token generator from .env is used.
  bru.setVar("token_generator_url", bru.getEnvVar("token_generator_url") || bru.getProcessEnv("TOKEN_GENERATOR_URL"));
  bru.setVar("token_generator_user", bru.getEnvVar("token_generator_user") || bru.getProcessEnv("TOKEN_BASIC_AUTH_USER"));
  bru.setVar("token_generator_password", bru.getEnvVar("token_generator_password") || bru.getProcessEnv("TOKEN_BASIC_AUTH_PW"));
}

script:post-response {
  let data = res.getBody();
  bru.setEnvVar("jwt",data);
  
  // Check if the response contains a valid token
  if (!data || data.trim() === '') {
    console.error('Failed to retrieve a valid token');
    return;
  }
  bru.setEnvVar("jwt", data);
  bru.setEnvVar("jwt_from", Date.now());
  bru.setEnvVar("jwt_env", bru.getEnvVar("Environment"));
}
