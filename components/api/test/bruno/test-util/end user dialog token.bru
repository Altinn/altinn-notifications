meta {
  name: end user dialog token
  type: http
  seq: 2
}

get {
  url: {{process.env.TOKEN_GENERATOR_URL}}/api/GetPersonalToken?env={{Environment}}&scopes=altinn:portal/enduser digdir:dialogporten.noconsent&userId={{AuthN_UserId}}&partyId={{AuthN_PartyId}}&pid={{AuthN_Pid}}
  body: none
  auth: basic
}

params:query {
  env: {{Environment}}
  scopes: altinn:portal/enduser digdir:dialogporten.noconsent
  userId: {{AuthN_UserId}}
  partyId: {{AuthN_PartyId}}
  pid: {{AuthN_Pid}}
}

auth:basic {
  username: {{process.env.TOKEN_BASIC_AUTH_USER}}
  password: {{process.env.TOKEN_BASIC_AUTH_PW}}
}

script:post-response {
  let data = res.getBody();
  bru.setEnvVar("jwt",data);
  
  // Check if the response contains a valid token
  if (!data || data.trim() === '') {
    console.error('Failed to retrieve a valid token');
    return;
  }
  bru.setEnvVar("jwt", data);
  bru.setEnvVar("jwt_from", Date.now());
  bru.setEnvVar("jwt_env", bru.getEnvVar("Environment"));
}
