# Test data for the Aspire stack (environment "v2 aspire"), matching the platform mocks in tools/src/Altinn.Notifications.Tools.PlatformMocks.
# Copy it to .env, or pass it to the Bruno CLI with: docker run --env-file aspire.env ...
# There are no secrets here: every person and organisation gets made-up contact points from the mocks.

TESTDATA_MY_EMAIL=aspire@example.com
TESTDATA_MY_PHONE=+4799999999

# Any national identity number and organisation number works, but since #1948 the API only looks up names for ones with valid check digits. These are just fixed ones.
TESTDATA_TENOR_SET_1_PERSON=01019010046
TESTDATA_TENOR_SET_1_ORG=310000019
TESTDATA_TENOR_SET_2_PERSON=01019010127
TESTDATA_TENOR_SET_2_ORG=310000027

TESTDATA_EXTERNAL_IDENTITY_IDPORTEN_EMAIL=aspire@example.com
TESTDATA_EXTERNAL_IDENTITY_LEGACY_USERNAME=aspire

# The API calls these itself, so they are localhost even when Bruno runs in Docker.
TESTDATA_URL_CONDITION_TRUE=http://localhost:5199/condition/true
TESTDATA_URL_CONDITION_FALSE=http://localhost:5199/condition/false
TESTDATA_URL_CONDITION_CORRUPT=http://localhost:5199/condition/corrupt
