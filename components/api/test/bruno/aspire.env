# Test data for the Aspire stack (environment "v2 aspire"), matching the platform mocks in tools/src/Altinn.Notifications.Tools.PlatformMocks.
# Copy it to .env, or pass it to the Bruno CLI with: docker run --env-file aspire.env ...
# There are no secrets here: every person and organisation gets made-up contact points from the mocks.

TESTDATA_MY_EMAIL=aspire@example.com
TESTDATA_MY_PHONE=+4799999999

# Any 11-digit national identity number and 9-digit organisation number works. These are just fixed ones.
TESTDATA_TENOR_SET_1_PERSON=12345678901
TESTDATA_TENOR_SET_1_ORG=310000002
TESTDATA_TENOR_SET_2_PERSON=12345678902
TESTDATA_TENOR_SET_2_ORG=310000003

TESTDATA_EXTERNAL_IDENTITY_IDPORTEN_EMAIL=aspire@example.com
TESTDATA_EXTERNAL_IDENTITY_LEGACY_USERNAME=aspire

# The API calls these itself, so they point to the API's machine even when Bruno runs in Docker.
# The API only accepts condition URLs with a top-level domain, so not localhost. local.altinn.cloud resolves to 127.0.0.1.
TESTDATA_URL_CONDITION_TRUE=http://local.altinn.cloud:5199/condition/true
TESTDATA_URL_CONDITION_FALSE=http://local.altinn.cloud:5199/condition/false
TESTDATA_URL_CONDITION_CORRUPT=http://local.altinn.cloud:5199/condition/corrupt

# Composed email. The API only checks the format of a SAS URL when it takes the order, so these made-up ones pass.
# The send time is far ahead, so the email service never tries to fetch them. There is no blob storage locally.
TESTDATA_REQUESTED_SEND_TIME=2099-01-01T08:00:00Z
TESTDATA_ATTACHMENT_SAS_URL=https://aspirelocal.blob.core.windows.net/attachments/test-document.pdf?sv=2024-11-04&sr=b&sp=r&se=2099-12-31T23:59:59Z&sig=mock
TESTDATA_ATTACHMENT_SAS_URL_2=https://aspirelocal.blob.core.windows.net/attachments/test-document-2.pdf?sv=2024-11-04&sr=b&sp=r&se=2099-12-31T23:59:59Z&sig=mock
