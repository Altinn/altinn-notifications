{
  "ContainerRuntime": "podman",
  "Postgres": {
    "UseContainer": true,
    "ContainerName": "notifications-db",
    "Port": 5432
  },
  "ServiceBus": {
    "HealthPort": 5300
  },
  "Auth": {
    "Mode": "mock",
    "Port": 5094
  },
  "Acs": {
    "Mode": "mock",
    "Port": 5095
  },
  "LinkMobility": {
    "Port": 5093,
    "Target": "",
    "Interactive": false,
    "DeliveryReportDelaySeconds": 2,
    "LogPayloads": "Masked",
    "PayloadFolder": ""
  },
  "Mocks": {
    "Enabled": true,
    "Profile": { "Enabled": true, "Port": 5131 },
    "Register": { "Enabled": true, "Port": 5121 },
    "Authorization": { "Enabled": true, "Port": 5151 },
    "Dialogporten": { "Enabled": true, "Port": 5171 },
    "Conditions": { "Enabled": true, "Port": 5199 },
    "Maskinporten": { "Enabled": true, "Port": 5197 }
  },
  "TestHarness": {
    "Intercept": false,
    "Port": 5096,
    "TimeoutSeconds": 120
  },
  "Triggers": {
    "Enabled": true,
    "Jobs": {
      "sendemail": { "Enabled": true, "IntervalSeconds": 15 },
      "sendemaildaytime": { "Enabled": true, "IntervalSeconds": 15 },
      "sendsmsanytime": { "Enabled": true, "IntervalSeconds": 15 },
      "sendsms": { "Enabled": true, "IntervalSeconds": 15, "Hours": "7-16" },
      "terminateexpirednotifications": { "Enabled": true, "IntervalSeconds": 60 },
      "deleteoldstatusfeedrecords": { "Enabled": false, "IntervalSeconds": 300, "Hours": "2-5" }
    }
  }
}
