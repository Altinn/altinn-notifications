<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>

		<!-- Altinn -->
		<PackageVersion Include="Altinn.ApiClients.Maskinporten" Version="10.2.1" />
		<PackageVersion Include="Altinn.Authorization.ProblemDetails" Version="6.0.0" />
		<PackageVersion Include="Altinn.Authorization.ProblemDetails.Abstractions" Version="6.0.0" />
		<PackageVersion Include="Altinn.Common.AccessToken" Version="5.1.20" />
		<PackageVersion Include="Altinn.Common.AccessTokenClient" Version="3.2.12" />
		<PackageVersion Include="Altinn.Common.PEP" Version="5.0.0" />
		<PackageVersion Include="Altinn.Register.Contracts" Version="1.8.0" />
		<PackageVersion Include="Altinn.Urn" Version="5.0.0" />

		<!-- Azure -->
		<PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
		<PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
		<PackageVersion Include="Azure.Identity" Version="1.21.0" />
		<PackageVersion Include="Azure.Messaging.EventGrid" Version="5.0.0" />
		<PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
		<PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
		<PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />

		<!-- Aspire, for the app host in tools/aspire and its hosting extensions. Keep the Aspire packages at the same version. -->
		<PackageVersion Include="Aspire.Hosting" Version="17.0.0" />
		<PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
		<PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />

		<!-- ASP.NET -->
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
		<PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />

		<!-- FluentValidation -->
		<PackageVersion Include="FluentValidation" Version="12.2.0" />
		<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />

		<!-- Link Mobility -->
		<PackageVersion Include="LinkMobilityNE.PSWin.Client" Version="1.4.0" />
		<PackageVersion Include="LinkMobilityNE.PSWin.Receiver" Version="1.4.0" />

		<!-- Microsoft Extensions -->
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />

		<!-- Npgsql -->
		<PackageVersion Include="Npgsql" Version="10.0.4" />
		<PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.4" />
		<PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.4" />

		<!-- OpenTelemetry -->
		<PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />

		<!-- Roslyn: WireMock.Net (via MetadataReferenceService.Abstractions) needs 5.9.0 while WolverineFx.RuntimeCompilation (via JasperFx.RuntimeCompiler) pins 5.0.0.
		     Pinning the roots keeps the exact-version Roslyn packages aligned (fixes NU1608). Remove when Wolverine/JasperFx bring 5.9.0 or later themselves. -->
		<PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Scripting" Version="5.9.0" />

		<!-- Other -->
		<PackageVersion Include="JWTCookieAuthentication" Version="4.0.4" />
		<PackageVersion Include="libphonenumber-csharp" Version="9.0.44" />
		<PackageVersion Include="Parquet.Net" Version="6.1.0" />
		<PackageVersion Include="RandomString4Net" Version="1.10.0" />
		<PackageVersion Include="System.IO.Hashing" Version="10.0.15" />
		<PackageVersion Include="System.Memory.Data" Version="10.0.15" />
		<PackageVersion Include="Testcontainers" Version="4.17.0" />
		<PackageVersion Include="WireMock.Net" Version="2.32.0" />
		<!-- Pins WireMock.Net's transitive dependency to the version with the fix for CVE-2026-118750 (GHSA-6527-9fp8-r4x6). Remove when WireMock.Net brings 2.3.14 or later itself. -->
		<PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />

		<!-- Quality / Testing -->
		<PackageVersion Include="coverlet.collector" Version="10.1.1" />
		<PackageVersion Include="FluentAssertions" Version="7.2.2" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />

		<!-- Swagger -->
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
		<PackageVersion Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />

		<!-- Wolverine -->
		<PackageVersion Include="WolverineFx" Version="6.64.2" />
		<PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.64.2" />
		<PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.2" />

		<!-- xUnit -->
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
		<PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />

		<!-- Yuniql -->
		<PackageVersion Include="Yuniql.AspNetCore" Version="1.2.25" />
		<PackageVersion Include="Yuniql.PostgreSql" Version="1.3.15" />

	</ItemGroup>
</Project>